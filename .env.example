# Gemini API 키 (aistudio.google.com/apikey 에서 무료로 발급)
GEMINI_API_KEY=
# 카드뉴스를 만들 모델 (기본 gemini-3.5-flash-lite: 무료 하루 약 500회)
GEMINI_MODEL=gemini-3.5-flash-lite

# 새 Supabase 프로젝트 > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# YouTube Data API v3 키: 홈의 채널 전체 목록(오래된 순)과 댓글 참고에 쓴다. 없으면 목록이 안 보이고 댓글 없이 만든다.
YOUTUBE_API_KEY=

# (선택) 앱 전체 하루 생성 한도 (Gemini 무료 한도보다 조금 적게)
DAILY_GENERATE_LIMIT=400

# 관리자 페이지(/admin)를 볼 수 있는 이메일, 쉼표로 여러 개
ADMIN_EMAILS=
